include README.md LICENSE CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md SUPPORT.md
include pyproject.toml requirements.txt .editorconfig .gitattributes .gitignore docker-run.sh
recursive-include scripts *.py

include README.md LICENSE CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md SUPPORT.md
include modules/policy-studio/compose.yml
include pyproject.toml requirements.txt .env.example .editorconfig .gitattributes .gitignore .dockerignore docker-run.sh setup.cfg
recursive-include core *.py *.sh *.md Dockerfile *.txt *.yaml *.yml *.json
include var/README.md var/artifacts/README.md var/deployments/README.md var/releases/README.md var/workspaces/README.md
recursive-include modules *.py *.sh *.md *.yaml *.yml *.json *.jsonl *.html *.pdf *.ts *.tsx *.css *.txt Dockerfile
recursive-include tests *.py *.json *.md
recursive-include tools *.py *.sh *.md
recursive-include docs *.md
recursive-include .github *.yml *.md

# Distribution archives contain source and entry-point documentation, not local
# analyst state, replay datasets, generated evidence or approved deployment bundles.
prune var/workspaces/strategies
prune var/artifacts/candidates
prune var/artifacts/tool-bundles
prune var/artifacts/replay-flows
prune var/artifacts/evaluations
prune var/artifacts/baselines
prune var/releases/approved
prune var/deployments/production
prune var/reports
prune var/data
prune var/operator-state
prune var/cache

global-exclude *.py[cod] *.pyo *.egg *.whl
prune .pytest_cache
prune .ruff_cache
prune .mypy_cache
prune build
prune dist
prune .tox
prune .nox
prune var/venv
prune var/build
prune var/dist
prune venv
prune node_modules
prune modules/policy-studio/frontend/dist
prune modules/policy-studio/frontend/node_modules
prune modules/policy-studio/frontend/.vite

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwflow.local/schemas/routing-dag.schema.json",
  "title": "UWflow acyclic policy routing graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "stage", "kind", "entry_node", "inputs", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "stage": {"type": "string"},
    "kind": {"const": "routing_dag"},
    "description": {"type": "string"},
    "entry_node": {"type": "string"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "type"],
      "properties": {"field": {"type": "string"}, "type": {"enum": ["boolean", "integer", "number", "string"]}}
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["condition_split", "source_plan", "outcome"]},
        "label": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "action": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "op", "value"],
      "properties": {
        "field": {"type": "string"},
        "op": {"enum": ["==", "!=", "<", "<=", ">", ">=", "in", "between"]},
        "value": {}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "target", "is_default"],
      "properties": {
        "id": {"type": "string"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "is_default": {"type": "boolean"},
        "priority": {"type": "integer"},
        "condition": {"$ref": "#/$defs/condition"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uwflow.local/schemas/dmn-table.schema.json",
  "title": "UWflow Stage 1 single-predicate underwriting checks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "stage",
    "kind",
    "description",
    "inputs",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "stage": {
      "const": "stage_1_hard_gates"
    },
    "kind": {
      "const": "dmn_table"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "type"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string"
          ]
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "==",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "in",
            "between"
          ]
        },
        "value": {}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "field",
        "description",
        "valid_when",
        "failure_reason_code"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "field": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "valid_when": {
          "$ref": "#/$defs/predicate"
        },
        "failure_reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    }
  }
}

# Local-only example. Generate real local credentials with:
# bash tools/guides/workflow/03-create-local-credentials.sh
KESTRA_SERVER_BASIC_AUTH_USERNAME=admin@uwflow.local
KESTRA_SERVER_BASIC_AUTH_PASSWORD=GENERATE_WITH_tools/guides/workflow/03-create-local-credentials.sh
# Base64-encoded placeholder, not a usable production secret.
SECRET_UNDERWRITING_WEBHOOK_KEY=cmVwbGFjZS10aGlzLXdpdGgtYS1sb25nLXJhbmRvbS1zZWNyZXQ=

# Optional CLI/API fallback only. Prefer entering the verified live PROD release in the Studio.
UWFLOW_BASELINE_RELEASE=

# Optional local Policy Studio host ports. Services remain bound to loopback.
UWFLOW_STUDIO_API_PORT=9000
UWFLOW_STUDIO_WEB_PORT=5173

# Optional local pointer to the exact approved release currently deployed in Kestra PROD.
UWFLOW_CURRENT_PROD_RELEASE=

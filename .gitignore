# Local environment and secrets
.env
.env.*
!.env.example
.env.history
.env.history.kestra

# Python bytecode and environments
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
env/

# Packaging/build outputs
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
.tox/
.nox/

# Test, coverage, and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Frontend dependencies and build output
modules/policy-studio/frontend/node_modules/
modules/policy-studio/frontend/dist/
modules/policy-studio/frontend/.vite/

# UWflow operational state lives only under var/.
# Keep the explanatory entry points and approved production packages in Git;
# ignore analyst work, local datasets, reports, replay evidence and operator state.
/var/*
!/var/README.md
!/var/artifacts/
/var/artifacts/*
!/var/artifacts/README.md
!/var/workspaces/
/var/workspaces/*
!/var/workspaces/README.md
!/var/releases/
/var/releases/*
!/var/releases/README.md
!/var/releases/approved/
!/var/releases/approved/**
!/var/deployments/
/var/deployments/*
!/var/deployments/README.md

# Temporary files
*.tmp
*.temp
